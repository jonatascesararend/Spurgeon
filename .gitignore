# ── Dados do usuário e saídas pesadas (nunca versionar) ──────────────
# Pasta onde ficam os projetos gerados (vídeos, .srt, shorts, logs)
Projetos/
output/

# Pasta de entrada (vídeos brutos a serem editados)
downloads/
Downloads/

# Vídeo e áudio em qualquer pasta (um vídeo de sermão passa de 100 MB, o limite do GitHub, e o
# histórico do git não esquece): inclui a introdução e a vinheta fixas de recursos/
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.mp3
*.m4a
*.aac
*.flac

# Arquivos pessoais de recursos/: a marca d'água e outras imagens da igreja, e scripts avulsos.
# Fontes, dicionários, ícone e vocabulário teológico continuam versionados.
recursos/*.png
recursos/*.jpg
recursos/*.jpeg
recursos/*.webp
recursos/*.py

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/
.python-version

# ── Ferramentas de desenvolvimento ────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── Modelos e caches de IA (grandes) ──────────────────────────────────
models/
modelos/
.cache/
*.bin
*.pt
*.pth
*.onnx
*.gguf

# ── Mídia temporária / intermediários de renderização ─────────────────
*.tmp
temp/
tmp/
*.wav
TEMP_MPY_*

# ── Editor / sistema operacional ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Segredos e configuração local ─────────────────────────────────────
# O config.toml e o integracoes.json (cofre das redes) ficam em %LOCALAPPDATA%\Spurgeon, fora do
# repositório; as linhas abaixo existem para o caso de alguém copiá-los para cá.
.env
.env.*
!.env.example
*.local.toml
*.local.json
config.toml
integracoes.json
# Credenciais baixadas dos painéis das redes (o do Google se chama client_secret_….json)
client_secret*.json
*.pem
*.key
*.p12
*.pfx

# Registros (instalacao.log do instalar.bat, interface.log)
*.log
