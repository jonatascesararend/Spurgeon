# Fim de linha: código e documentos em LF; scripts do Windows em CRLF.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
uv.lock text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Mídia: binários, sem conversão.
*.mp4 binary
*.mkv binary
*.wav binary
*.ttf binary
*.otf binary

# Dicionário Hunspell: lido como está (um CR sobrando quebra as marcas de cada palavra).
recursos/dicionarios/** -text
